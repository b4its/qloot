# ============================================================================
# QLoot environment template
# Copy to .env and fill in real values. NEVER commit the real .env.
# ============================================================================

APP_ENV=development
APP_NAME=QLoot
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

# --- Database ---------------------------------------------------------------
POSTGRES_DB=qloot
POSTGRES_USER=qloot
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://qloot:change-me@postgres:5432/qloot

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Sessions / auth --------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=change-me
SESSION_COOKIE_NAME=qloot_session
SESSION_SECURE=false
SESSION_SAME_SITE=lax
SESSION_TTL_SECONDS=1209600

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- AI ---------------------------------------------------------------------
# Provider: "mock" (offline deterministic simulation), "openai"
# (any OpenAI-compatible /chat/completions endpoint), or "gemini".
# NOTE: choosing "openai"/"gemini" without its key fails fast (never silently
# falls back to the mock, which would fabricate grades).
AI_PROVIDER=openai
# OpenAI-compatible endpoint (used when AI_PROVIDER=openai).
#  - Running the backend locally (`make dev-backend`): use localhost.
#  - Running the backend in Docker: the gateway runs on the HOST, so use
#    http://host.docker.internal:20128/v1 (compose maps host.docker.internal
#    to the docker bridge gateway).
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_GENERATION_MODEL=hk/deepseek-4.1-flash
AI_SCORING_MODEL=hk/deepseek-4.1-flash
GEMINI_API_KEY=
AI_HTTP_TIMEOUT_SECONDS=60
AI_MAX_UPLOAD_BYTES=10485760
# Display name of the built-in study/career assistant.
ASSISTANT_NAME=Asisten Qlo

# --- Blockchain -------------------------------------------------------------
CHAIN_ID=31337
BLOCKCHAIN_NETWORK=localhost
SEPOLIA_RPC_URL=
LOCALHOST_RPC_URL=http://anvil:8545
# DO NOT pass private keys on the command line. Env / docker secret only.
BLOCKCHAIN_PRIVATE_KEY=
ETHERSCAN_API_KEY=
# Shared custodial wallet: pooled on-chain assets live at this treasury
# address, while each user's *share* is tracked per-user in the double-entry
# ledger (wallet_accounts.cached_balance). Withdrawals remove the amount from
# circulation on-chain and the user's focused balance is debited off-chain.
TREASURY_ADDRESS=
# Personal wallet pre-filled for every account. Users may change their own at
# /wallet (paste an address or connect MetaMask); withdrawals go to it. Leave
# blank in the template — set the real platform address in your local .env.
DEFAULT_WALLET_ADDRESS=
# --- QLoot digital assets (4 separate ERC-1155 UUPS contracts) ---------------
# Each asset has its own address (see `make blockchain-status`):
#   OPT = OryphemToken (base currency, unlimited)
#   QTC = QlootChain (premium asset, cap 1e15)
#   ORT = OryphemIntelligence (AI credit, 1 request = 1 ORT)
#   ORX = OryphemProxy (router: 1 ORT = 50 OPT, 1 QTC = 1000 OPT)
OPT_CONTRACT_ADDRESS=
QTC_CONTRACT_ADDRESS=
ORT_CONTRACT_ADDRESS=
ORX_CONTRACT_ADDRESS=
# OryphemProxy (ORX) rates, in OPT per 1 unit of the target asset.
ORX_ORT_RATE=50
ORX_QTC_RATE=1000
# Legacy alias for OPT (kept for backwards compatibility).
OPC_CONTRACT_ADDRESS=
OPC_TOKEN_ID=0
OPC_CONFIRMATIONS=2
OPC_MAX_REWARD_PER_TX=100000
# When true (default in dev) the blockchain worker uses an in-process fake chain.
BLOCKCHAIN_DRY_RUN=true

# --- Object storage ---------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=qloot-materials
MINIO_SECURE=false

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
