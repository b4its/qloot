# ============================================================================
# QLoot environment template
# Copy to .env and fill in real values. NEVER commit the real .env.
# ============================================================================

APP_ENV=development
APP_NAME=QLoot
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

# --- Database ---------------------------------------------------------------
POSTGRES_DB=qloot
POSTGRES_USER=qloot
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://qloot:change-me@postgres:5432/qloot

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Sessions / auth --------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=change-me
SESSION_COOKIE_NAME=qloot_session
SESSION_SECURE=false
SESSION_SAME_SITE=lax
SESSION_TTL_SECONDS=1209600

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- AI ---------------------------------------------------------------------
# Leave empty to use the deterministic mock provider (offline dev/CI).
GEMINI_API_KEY=
AI_PROVIDER=mock
AI_GENERATION_MODEL=gemini-2.0-flash
AI_SCORING_MODEL=gemini-2.0-flash
AI_HTTP_TIMEOUT_SECONDS=60
AI_MAX_UPLOAD_BYTES=10485760

# --- Blockchain -------------------------------------------------------------
CHAIN_ID=31337
BLOCKCHAIN_NETWORK=localhost
SEPOLIA_RPC_URL=
LOCALHOST_RPC_URL=http://anvil:8545
# DO NOT pass private keys on the command line. Env / docker secret only.
BLOCKCHAIN_PRIVATE_KEY=
ETHERSCAN_API_KEY=
TREASURY_ADDRESS=
OPC_CONTRACT_ADDRESS=
OPC_TOKEN_ID=0
OPC_CONFIRMATIONS=2
OPC_MAX_REWARD_PER_TX=100000
# When true (default in dev) the blockchain worker uses an in-process fake chain.
BLOCKCHAIN_DRY_RUN=true

# --- Object storage ---------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=qloot-materials
MINIO_SECURE=false

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
