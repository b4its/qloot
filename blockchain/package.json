{
  "name": "qloot-blockchain",
  "version": "1.0.0",
  "description": "QLoot digital assets (OPT/QTC/ORT + ORX router) — ERC-1155 Hardhat contracts",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "format": "prettier --write \"**/*.{sol,js,json}\" --ignore-path .prettierignore",
    "lint": "solhint \"contracts/**/*.sol\""
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "dotenv": "^16.6.1",
    "hardhat": "^2.29.1"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "@openzeppelin/contracts-upgradeable": "^5.6.1"
  }
}
